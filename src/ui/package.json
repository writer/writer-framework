		"codegen": "node tools/generator.mjs",
		"custom.dev": "vite --config vite.config.custom.ts",
		"custom.build": "vite build --config vite.config.custom.ts",
		"custom.check": "node tools/custom_check.mjs",
		"test": "vitest run",
		"test.watch": "vitest dev"
	},
